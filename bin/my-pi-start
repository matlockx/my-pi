#!/usr/bin/env fish
# Starts the my-pi host proxies: GitHub MCP (ghmcp, 127.0.0.1:8082) and Go
# modules (gomodproxy, 127.0.0.1:8083). A proxy already listening is left alone.
# Run from a host terminal after each login, never from an omp session.
#
# Copied to ~/bin by my-pi/setup.fish. ghmcp and gomodproxy come from the
# ~/.config/fish/conf.d/my-pi.fish link that setup.fish creates.

set -l failed 0
ghmcp start; or set failed 1
gomodproxy start; or set failed 1
exit $failed
