#!/usr/bin/env fish
# Starts the my-pi host proxies: GitHub MCP (ghmcp, 127.0.0.1:8082), Go
# modules (gomodproxy, 127.0.0.1:8083), Jira MCP (jiramcp, 127.0.0.1:8084)
# and, when jflow is on PATH, the jflow MCP server (127.0.0.1:8765, the
# JFLOW_MCP_URL of the jflow-mcp extension). GitHub, Jira and jflow run behind
# the MCP guard (my-pi/mcp/guard), their real servers on 18082, 18084 and
# 18765. The Kubernetes (kubemcp, 127.0.0.1:8085), AWS (awsmcp, 8086) and
# vcluster (vclustermcp, 8087) MCP servers run as stdio children of their
# guard and have no port of their own, as does the lifepace production MCP
# (lifepacemcp, 8088), which holds the only ssh path to the lifepace server.
# usagesync (hourly usage collection, my-pi/extensions/usage) has no port
# either; it is tracked by its pid file. A server already listening is left
# alone. Servers listed in
# disabledServers of ~/.omp/agent/mcp.json (set by the MCP setup wizard,
# my-pi/mcp/setup/wizard.mjs) are not started.
#
#   my-pi-start            start what is not running
#   my-pi-start restart    stop every server, then start them all
#
# Every call prints one line per server with its pid and log file, whether it
# was started now or was already running; a server that is not running says
# why. Keep that contract when adding a server.
#
# Run from a host terminal after each login, never from an omp session.
#
# Copied to ~/bin by my-pi/setup.fish. ghmcp, gomodproxy and jiramcp come from
# the ~/.config/fish/conf.d/my-pi.fish link that setup.fish creates.

# DEV-NOTE: a script runs without job control, so every server would share this script's
# process group: the terminal's foreground group while it runs (Ctrl-C and tty access hit
# all of them), and `ghmcp stop` (kill -- -pgid) would take down every other server too.
# Full job control puts each background job in its own group.
status job-control full

set -l jflow_port 8765
set -l jflow_log ~/.local/state/jflowmcp.log

function __my_pi_listener --argument-names port
    lsof -t -nP -iTCP:$port -sTCP:LISTEN 2>/dev/null
end

# Waits up to 10 s for port to be released; returns 1 when it is still taken.
function __my_pi_wait_free --argument-names port name
    for i in (seq 10)
        test -z "$(__my_pi_listener $port)"; and return 0
        command sleep 1
    end
    echo "$name: port $port still in use (pid "(__my_pi_listener $port)")" >&2
    return 1
end

# Starts the guard script rel (path under my-pi/mcp) as name on port, waiting up to wait seconds.
function __my_pi_guard_start --argument-names name port rel logfile wait
    set -l listening (__my_pi_listener $port)
    if test -n "$listening"
        echo "$name: already running on http://127.0.0.1:$port/ (pid $listening, log: $logfile)"
        return 0
    end
    # The repo is found through the ghmcp function, since this script runs from ~/bin.
    set -l guard (path resolve (path dirname (path resolve (functions --details ghmcp)))/../../mcp/$rel)
    mkdir -p (path dirname $logfile)
    # DEV-NOTE: stdin from /dev/null for the same reason as ghmcp: a background
    # process with a tty stdin is stopped by SIGTTIN.
    nohup node $guard </dev/null >$logfile 2>&1 &
    set -l pid $last_pid
    disown
    for i in (seq $wait)
        if test -n "$(__my_pi_listener $port)"
            echo "$name: up on http://127.0.0.1:$port/ (pid $pid, log: $logfile)"
            return 0
        end
        kill -0 $pid 2>/dev/null; or break
        command sleep 1
    end
    echo "$name: not listening (pid $pid); see $logfile" >&2
    return 1
end

# Stops whatever listens on port; a guard stops its server child on SIGTERM.
function __my_pi_port_stop --argument-names name port
    set -l listening (__my_pi_listener $port)
    if test -z "$listening"
        echo "$name: not running"
        return 0
    end
    kill -TERM $listening
    echo "$name: stopped (pid $listening)"
end

switch "$argv[1]"
    case ''
    case restart
        ghmcp stop
        gomodproxy stop
        jiramcp stop
        command -q jflow; and __my_pi_port_stop "jflow mcp" $jflow_port
        __my_pi_port_stop kubemcp 8085
        __my_pi_port_stop awsmcp 8086
        __my_pi_port_stop vclustermcp 8087
        __my_pi_port_stop lifepacemcp 8088
        usagesync stop
        set -l busy 0
        # Upstream ports too: a guard frees its own port before its server child exits.
        __my_pi_wait_free 8082 ghmcp; or set busy 1
        __my_pi_wait_free 18082 github-mcp-server; or set busy 1
        __my_pi_wait_free 8083 gomodproxy; or set busy 1
        __my_pi_wait_free 8084 jiramcp; or set busy 1
        __my_pi_wait_free 18084 mcp-atlassian; or set busy 1
        __my_pi_wait_free $jflow_port "jflow mcp"; or set busy 1
        __my_pi_wait_free 18765 "jflow mcp (upstream)"; or set busy 1
        __my_pi_wait_free 8085 kubemcp; or set busy 1
        __my_pi_wait_free 8086 awsmcp; or set busy 1
        __my_pi_wait_free 8087 vclustermcp; or set busy 1
        __my_pi_wait_free 8088 lifepacemcp; or set busy 1
        test $busy -eq 0; or exit 1
    case '*'
        echo "usage: my-pi-start [restart]" >&2
        exit 2
end

# Empty when the file or jq is missing: then every server starts.
set -l disabled (jq -r '.disabledServers[]? // empty' ~/.omp/agent/mcp.json 2>/dev/null)
set -l off "disabled (disabledServers in ~/.omp/agent/mcp.json)"

set -l failed 0
if contains github $disabled
    echo "ghmcp: $off"
else
    ghmcp start; or set failed 1
end
gomodproxy start; or set failed 1
if contains jira $disabled
    echo "jiramcp: $off"
else
    jiramcp start; or set failed 1
end
if contains jflow $disabled
    echo "jflow mcp: $off"
else if command -q jflow
    __my_pi_guard_start "jflow mcp" $jflow_port jflow/guard.mjs $jflow_log 10; or set failed 1
else
    echo "jflow mcp: jflow not on PATH; not started"
end
# Kubernetes, AWS and vcluster MCP: stdio servers behind the guard, no upstream port.
if contains kube $disabled
    echo "kubemcp: $off"
else if command -q kubernetes-mcp-server
    __my_pi_guard_start kubemcp 8085 kube/guard.mjs ~/.local/state/kubemcp.log 20; or set failed 1
else
    echo "kubemcp: kubernetes-mcp-server not on PATH (brew install kubernetes-mcp-server); not started"
end
if contains aws $disabled
    echo "awsmcp: $off"
else if command -q uvx
    # First start downloads the package and its AWS CLI.
    __my_pi_guard_start awsmcp 8086 aws/guard.mjs ~/.local/state/awsmcp.log 180; or set failed 1
else
    echo "awsmcp: uvx not on PATH (brew install uv); not started"
end
if contains vcluster $disabled
    echo "vclustermcp: $off"
else if command -q vcluster; and command -q kubectl
    __my_pi_guard_start vclustermcp 8087 vcluster/guard.mjs ~/.local/state/vclustermcp.log 20; or set failed 1
else
    echo "vclustermcp: vcluster or kubectl not on PATH (brew install loft-sh/tap/vcluster kubectl); not started"
end
# lifepace production: needs the lifepace checkout (LIFEPACE_REPO, default ~/projects/lifepace).
set -l lifepace_repo (set -q LIFEPACE_REPO; and echo $LIFEPACE_REPO; or echo ~/projects/lifepace)
if contains lifepace $disabled
    echo "lifepacemcp: $off"
else if test -x $lifepace_repo/deploy/prod-sql.sh
    __my_pi_guard_start lifepacemcp 8088 lifepace/guard.mjs ~/.local/state/lifepacemcp.log 20; or set failed 1
else
    echo "lifepacemcp: no $lifepace_repo/deploy/prod-sql.sh (set LIFEPACE_REPO); not started"
end
usagesync start; or set failed 1

exit $failed
