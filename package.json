{
  "name": "pi-my-config",
  "version": "0.1.0",
  "private": true,
  "description": "Personal Pi agent config — Go-focused with infra, TS, and Python support",
  "scripts": {
    "test": "node --test 'extensions/**/*.test.{mjs,ts}' 'mcp/**/*.test.mjs'",
    "coverage": "mkdir -p target/coverage/typescript && node --test --experimental-test-coverage --test-reporter=lcov --test-reporter-destination=target/coverage/typescript/lcov.info 'extensions/**/*.test.{mjs,ts}' 'mcp/**/*.test.mjs'"
  },
  "dependencies": {
    "@gtheys/pi-per-commit-spend": "latest",
    "@shikijs/cli": "^4.0.2",
    "@sting8k/pi-vcc": "^0.3.12",
    "@tomooshi/condensed-milk-pi": "^1.9.0",
    "better-sqlite3": "^12.10.0",
    "diff": "^9.0.0",
    "graphify-pi": "^0.3.0",
    "shiki": "^4.0.2"
  },
  "pi": {
    "extensions": [
      "./extensions/setup/index.ts",
      "./extensions/skill-sources/index.ts",
      "./extensions/context.ts",
      "./extensions/review/review.ts",
      "./extensions/quick-review/index.ts",
      "./extensions/git-gate/index.ts",
      "./extensions/push-gate/index.ts",
      "./extensions/pr-review/index.ts",
      "./extensions/client-ip-check/index.ts",
      "./extensions/tool-pills/index.ts",
      "./extensions/desktop-notify/index.ts",
      "./extensions/memory/index.ts",
      "./extensions/agent-mode/index.ts",
      "./extensions/lean-footer/index.ts",
      "./extensions/lean-output/index.ts",
      "./extensions/secret-redactor/index.ts",
      "./extensions/jflow-mcp/index.ts",
      "./extensions/usage/index.ts",
      "./node_modules/@tomooshi/condensed-milk-pi/index.ts",
      "./node_modules/@sting8k/pi-vcc/index.ts",
      "./node_modules/graphify-pi/extensions/graphify.ts"
    ],
    "skills": [
      "./skills"
    ],
    "prompts": [
      "./prompts"
    ],
    "themes": [
      "./themes"
    ]
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "latest",
    "@earendil-works/pi-coding-agent": "latest",
    "@earendil-works/pi-tui": "latest",
    "@types/better-sqlite3": "latest",
    "@types/diff": "latest"
  }
}
